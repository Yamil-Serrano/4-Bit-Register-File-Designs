	)
	(gr_text "RS1 : source register for Read Port 1\nRS2 : source register for Read Port 2\nRD  : destination register for Write\nRW  : Register Write (active high)"
		(at 81.28 45.72 0)
		(layer "F.SilkS")
		(uuid "aaca23f5-c021-4636-b50c-7d7f97604e20")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom)
		)
	)
	(gr_text "NOTES:\nPlace 100nF ceramic cap close \nto each IC.\nPlace 100uF elect. cap at power \ninput connector.\nPower board with 5V.\n\n→ (arrow) indicates (LSB)\nBit numbering increases in\narrow direction.\n\nWhen RW is HIGH, the data on the \ninput  bus is written to the register \nselected  by RD on the rising clock \nedge.\n"
		(at 81.28 111.76 0)
		(layer "F.SilkS")
		(uuid "b3ee7fcb-d3b1-4ea4-ab1d-8dfb63e407a1")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom)
		)
	)
